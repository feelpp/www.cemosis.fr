---
import { getCollection } from 'astro:content';
import DiscussionList from '../../../components/DiscussionList.astro';
import NewsHighlights from '../../../components/NewsHighlights.astro';
import Site from '../../../layouts/Site.astro';
import { languages, labels, route, newsDateLabel, type Language } from '../../../lib/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language, t = labels[lang];
const news = (await getCollection('news', ({ data }) => data.lang === lang && !data.draft)).filter(item => item.data.historical).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Site title={t.news} description={t.newsIntro} lang={lang} path="news">
  <section class="page-intro container"><p class="eyebrow">Cemosis / GitHub</p><h1>{t.newsTitle}</h1><p class="lead">{t.newsIntro}</p><a class="text-link" href={route(lang, 'discussions')}>{lang === 'fr' ? 'Publications et échanges récents : Discussions Feel++' : 'Recent publications and discussions: Feel++ Discussions'} →</a></section>
  <section class="container listing-section"><NewsHighlights lang={lang} /><h2 class="archive-heading">{lang === 'fr' ? 'Toutes les publications GitHub' : 'All GitHub publications'}</h2><DiscussionList lang={lang} /></section>
  <section class="container listing-section"><details><summary>{t.archive}</summary><div class="news-list">{news.map(({ data: n }) => <a href={route(lang, `news/${n.slug}`)} class="news-row"><time datetime={n.date.toISOString()}>{newsDateLabel(n.date, lang, n.endDate)}</time><div><span class="card-meta">{n.category}</span><h2>{n.title}</h2><p>{n.description}</p></div><span aria-hidden="true">↗</span></a>)}{news.length === 0 && <p>{t.noNews}</p>}</div></details></section>
</Site>
