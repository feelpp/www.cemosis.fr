---
import redirects from '../data/redirects.json';
import { url } from '../lib/site';
export function getStaticPaths() {
  return redirects.map(({ from, to }) => ({ params: { legacy: from }, props: { to } }));
}
const target = url(`${Astro.props.to}/`);
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta http-equiv="refresh" content={`0;url=${target}`} /><meta name="robots" content="noindex" /><link rel="canonical" href={new URL(target, Astro.site)} /><title>Cemosis — Page déplacée / Page moved</title></head><body><p>Cette page a déménagé. / This page has moved.</p><a href={target}>Continuer / Continue →</a></body></html>
