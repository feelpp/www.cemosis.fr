---
import TopicTags from './TopicTags.astro';
import { topicIds } from '../lib/topics';
import Site from '../layouts/Site.astro';
import FundingList from './FundingList.astro';
import SoftwareList from './SoftwareList.astro';
import NewsHighlights from './NewsHighlights.astro';
import Video from './Video.astro';
import videos from '../data/videos.json';

import { labels, expertise, route, url, type Language } from '../lib/site';
import institutions from '../data/institutions.json';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = labels[lang];
const cityImage = '/images/chicago/downtown.png';
---
<Site title="Cemosis" description={t.heroText} lang={lang}>
  <section class="hero container">
    <div class="hero-copy hero-topics"><p class="eyebrow">{t.eyebrow}</p><h1>{lang === 'fr' ? 'Modéliser, simuler, comprendre' : 'Model, simulate, understand'}</h1><p class="hero-description">{t.heroText}</p><TopicTags lang={lang} ids={[...topicIds]} /><a class="text-link" href={route(lang, 'services')}>{t.explore}<span aria-hidden="true">→</span></a></div>
    <figure class="hero-art hero-simulation"><img src={url(cityImage)} alt={lang === 'fr' ? 'Reconstruction géométrique du centre de Chicago avec Ktirio' : 'Geometric reconstruction of downtown Chicago with Ktirio'} width="1430" height="780" /><figcaption><a href={route(lang, 'projects/ktirio-urban-building')}>Ktirio Urban Building</a><a href={route(lang, 'news/chicago-numpex-sc2026')}>{lang === 'fr' ? 'Chicago · NumPEx' : 'Chicago · NumPEx'} ↗</a></figcaption></figure>
  </section>
  <section class="research-strip"><div class="container research-inner"><p>{t.hosted}</p><div class="institution-names">{institutions.slice(1).map(institution => <a href={institution.url}>{institution.name}</a>)}</div></div></section>

  <section class="section news-section container"><div class="section-heading"><h2>{t.newsTitle}</h2><a class="text-link" href={route(lang, 'news')}>{t.allNews} →</a></div><p class="section-intro">{lang === 'fr' ? 'La vie de la plateforme et les dernières publications de notre communauté.' : 'Platform news and the latest publications from our community.'}</p><NewsHighlights lang={lang} /></section>
  <section class="section projects-section"><div class="container"><div class="section-heading"><h2>{lang === 'fr' ? 'Projets et financements' : 'Projects and funding'}</h2><a class="text-link" href={route(lang, 'projects')}>{t.allProjects} →</a></div><FundingList lang={lang} /></div></section>
  <section class="section container"><div class="section-heading"><h2>{t.softwareTitle}</h2><a class="text-link" href={route(lang, 'software')}>{t.softwareLink} →</a></div><SoftwareList lang={lang} /></section>
  <section class="section container" id="expertise"><div class="section-heading"><h2>{t.mission}</h2><p>{t.missionText}</p></div><div class="expertise-grid">{expertise[lang].map(e => <a class="expertise-card" href={route(lang, 'services')}><h3>{e.title}</h3><p>{e.text}</p><span class="expertise-arrow" aria-hidden="true">→</span></a>)}</div></section>
  <section class="section container"><div class="section-heading"><h2>{lang === 'fr' ? 'Simulations en vidéo' : 'Simulation videos'}</h2><a class="text-link" href={route(lang, 'videos')}>{lang === 'fr' ? 'Toutes les vidéos' : 'All videos'} →</a></div><div class="video-grid">{videos.items.slice(0, 2).map(video => <Video id={video.id} title={video.title} poster={video.poster} lang={lang} />)}</div></section>
  <section class="contact-section"><div class="container contact-inner"><h2>{t.ctaTitle}</h2><a class="text-link" href="mailto:contact@cemosis.fr">contact@cemosis.fr <span aria-hidden="true">→</span></a></div></section>
</Site>
