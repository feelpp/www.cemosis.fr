---
import { getCollection } from 'astro:content';
import snapshot from '../data/discussions.json';
import media from '../data/discussion-media.json';
import { route, url, dateLabel, type Language } from '../lib/site';
interface Props { lang: Language; limit?: number }
const {lang, limit = 6} = Astro.props;
const editorial = await getCollection('news', ({data}) => data.lang === lang && !data.draft && !data.historical);
const items = [
 ...snapshot.items.map(item => ({...item, path: `discussions/${item.number}`, editorial: false, image: undefined})),
 ...editorial.map(({data}) => ({title: data.title, body: '', createdAt: data.date.toISOString(), category: data.category, path: `news/${data.slug}`, editorial: true, image: data.image})),
].sort((a,b) => b.createdAt.localeCompare(a.createdAt)).slice(0, limit);
const imageFor = (body: string) => Object.entries(media).find(([source, asset]) => asset.mime.startsWith('image/') && body.includes(source))?.[1].path;
---
<div class="news-highlights">{items.map(item => {
 const image = item.image || imageFor(item.body);
 const version = item.title.match(/(?:V|v)\d+[^ ]*(?:\s+(?:preview|alpha|RC)[. ]?\d+)?/i)?.[0];
 const visualLabel = item.editorial ? item.category.split(' · ')[0] : version || (item.title.includes('benchmarking') ? 'Benchmarks' : item.title.includes('.fpp.json') ? '.fpp.json' : 'Feel++');
 return <a class="news-highlight" href={route(lang, item.path)}>
  <div class:list={['news-highlight-art', !image && 'news-highlight-type']}>
    {image ? <img src={url(image)} alt="" width="720" height="450" loading="lazy" /> : <><span>{visualLabel}</span><span>{item.category === 'Announcements' ? (lang === 'fr' ? 'Développements' : 'Developments') : item.category}</span></>}
  </div>
  <div class="news-highlight-copy"><time datetime={item.createdAt}>{dateLabel(new Date(item.createdAt),lang)}</time><h3>{item.title}</h3><span class="text-link">{lang === 'fr' ? 'Lire' : 'Read'} →</span></div>
 </a>;
})}</div>
