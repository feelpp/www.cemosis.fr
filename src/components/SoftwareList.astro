---
import software from '../data/software.json';
import { type Language } from '../lib/site';
interface Props { lang: Language }
const { lang } = Astro.props;
---
<div class="software-grid">{software.map(item => <section class="software-card"><p class="card-meta">{item.id === 'feelpp' ? (lang === 'fr' ? 'Calcul scientifique' : 'Scientific computing') : 'Ktirio'}</p><h3>{item.name}</h3><p>{item.description[lang]}</p><div class="software-links"><a class="text-link" href={item.repository}>{lang === 'fr' ? 'Code source' : 'Source code'} ↗</a>{item.documentation && <a class="text-link" href={item.documentation}>{lang === 'fr' ? 'En savoir plus' : 'Learn more'} ↗</a>}</div></section>)}</div>
