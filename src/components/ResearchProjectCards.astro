---
import type { CollectionEntry } from 'astro:content';
import { route, url, type Language } from '../lib/site';
interface Props { projects: (CollectionEntry<'funding'> | CollectionEntry<'projects'>)[]; lang: Language }
const { projects, lang } = Astro.props;
---
<div class="research-project-grid">{projects.map(({data: project}) => {
  const image = 'image' in project ? project.image : undefined;
  return <a class="research-project-card" href={route(lang, `projects/${project.slug}`)}>
    {image ? <img src={url(image)} alt="" width="600" height="360" loading="lazy" /> : <div class="research-project-placeholder" aria-hidden="true">{project.title}</div>}
    <div class="research-project-copy"><p class="card-meta">{project.category}</p><h3>{project.title}</h3><p>{project.description}</p><span class="text-link">{lang === 'fr' ? 'Découvrir le projet' : 'Explore the project'} →</span></div>
  </a>;
})}</div>
